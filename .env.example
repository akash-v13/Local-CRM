# Copy to .env (same folder) and fill in. .env is git-ignored; never commit a real key.
#   cp .env.example .env
#
# Anthropic API key for AI reply drafting. Get one at https://console.anthropic.com
# (Settings → API keys). Without it, everything else works and AI actions explain
# how to turn drafting on.
ANTHROPIC_API_KEY=
