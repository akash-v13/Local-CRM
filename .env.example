# Copy to .env (same folder) and fill in. .env is git-ignored; never commit a real key.
#   cp .env.example .env
#
# Anthropic API key for AI reply drafting. Get one at https://console.anthropic.com
# (Settings → API keys). Without it, everything else works and AI actions explain
# how to turn drafting on.
ANTHROPIC_API_KEY=

# TypeSafe AI key for reading customer messages with Jev (order numbers, category).
# Get one at https://console.typesafe.ai/settings/keys. Optional: without it Claude reads
# messages (needs ANTHROPIC_API_KEY), and without either, patterns alone are used.
TYPESAFE_API_KEY=
