# Copy to backend/.env when running the API outside Docker (uv run ...).
# Points at the Postgres started by `docker compose up db`.
DATABASE_URL=postgresql+psycopg://resolve:resolve@localhost:5432/resolve
APP_ENV=local

# Anthropic API key for AI drafting (see docs/dev/local-setup.md). Leave empty to turn AI off.
ANTHROPIC_API_KEY=
